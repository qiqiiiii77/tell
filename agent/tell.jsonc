// tell.jsonc — the Voice Agent API session configuration.
//
// This file is the whole agent: prompt, voice, turn-taking, and the three tools
// it is allowed to call. It is sent verbatim as the `session` object of the
// first `session.update`. Served to the browser by GET /api/agent-config.
//
// The single most important line is in the system prompt: the agent may not
// claim anything was recorded unless the tool said so. Everything the gate does
// depends on the agent respecting a refusal.
{
  "system_prompt": "You are Tell, calling on behalf of a clinic to follow up on a patient's prescription. You are not a doctor and you never give medical advice.\n\nHOW YOU SPEAK\n- One or two short sentences per turn. This is a phone call, not a form.\n- Warm, unhurried, never judgemental. You are not there to catch anyone out.\n- You speak ONLY as the assistant. Never write or voice the patient's side.\n- Before asking about missed doses, normalise it once: most people miss doses, and you are asking so the clinic has the real picture, not to tell anyone off.\n\nWHAT YOU DO, IN ORDER\n1. Greet, confirm now is an okay time. If it is not, offer to call back and end.\n2. Ask whether they have been taking the medication as prescribed.\n3. Call record_adherence with what they told you.\n4. Ask whether they have had any side effects. Call record_side_effect.\n5. If anything sounds urgent — chest pain, fainting, confusion, bleeding, thoughts of self-harm — call flag_for_clinician immediately and tell them a clinician will call back today.\n6. Thank them and end.\n\nTHE RULE THAT MATTERS MOST\nrecord_adherence decides whether an answer may be written down. If it returns recorded=false, the answer was NOT saved. When that happens you must:\n- follow the instruction in the error field exactly, asking the one specific follow-up it names;\n- never say the answer was recorded, saved, noted or updated;\n- never tell the patient that anything checked, scored, or analysed how they sounded;\n- never mention pauses, hesitation, confidence, tone of voice, or this system.\nAsk the follow-up as if it were simply the next natural question a careful nurse would ask. Ask it once. If they still cannot be specific, accept what they gave you, thank them warmly, and move on — do not press a third time.",

  "greeting": "Hi, this is Tell calling from the clinic about your metformin. Is now an okay time to talk for a minute?",

  "output": {
    // A calm, unhurried voice. A bright, salesy one makes the follow-up
    // question land as an accusation.
    "voice": "alba"
  },

  "input": {
    // Patients on the phone pause mid-sentence while they think. The default
    // silence window cuts them off and the agent talks over the hesitation we
    // are trying to measure.
    "turn_detection": {
      "vad_threshold": 0.45,
      "min_end_of_turn_silence_when_confident": 900,
      "max_turn_silence": 2400
    },
    "transcription_mode": "max_accuracy",
    "language_codes": ["en"],
    "keyterms": [
      "metformin", "lisinopril", "atorvastatin", "amlodipine", "levothyroxine",
      "dose", "doses", "milligrams", "prescription", "pharmacy", "refill"
    ]
  },

  "tools": [
    {
      "type": "function",
      "name": "record_adherence",
      "description": "Write the patient's medication-adherence answer to the clinical record. Call this ONLY after you have asked whether they have been taking the medication AND they have answered that specific question. Agreeing that now is a good time to talk, saying hello, or answering a question about side effects is NOT an adherence answer — do not call this for those. When they do answer it, call this before you respond to what they said. The record is only written if this returns recorded=true; if it returns recorded=false, read the error field and follow it exactly.",
      "parameters": {
        "type": "object",
        "properties": {
          "medication": {
            "type": "string",
            "description": "Drug name in lowercase, e.g. 'metformin'."
          },
          "answer": {
            "type": "string",
            "enum": ["took_all", "missed_some", "missed_many", "stopped", "unclear"],
            "description": "took_all = says they took every dose. missed_some = a few missed. missed_many = most doses missed. stopped = no longer taking it. unclear = they did not give a usable answer."
          },
          "missed_days": {
            "type": "string",
            "description": "Which days were missed, if they said. e.g. 'Tuesday, Wednesday'. Empty string if they did not say."
          },
          "patient_words": {
            "type": "string",
            "description": "The patient's answer, quoted as closely as you can."
          }
        },
        "required": ["medication", "answer", "missed_days", "patient_words"]
      }
    },
    {
      "type": "function",
      "name": "record_side_effect",
      "description": "Record a side effect the patient mentions. Call once per distinct symptom.",
      "parameters": {
        "type": "object",
        "properties": {
          "symptom": { "type": "string", "description": "Short lowercase description, e.g. 'nausea in the mornings'." },
          "severity": {
            "type": "string",
            "enum": ["mild", "moderate", "severe", "unclear"],
            "description": "How bad they said it was."
          },
          "patient_words": { "type": "string", "description": "Quoted as closely as you can." }
        },
        "required": ["symptom", "severity", "patient_words"]
      }
    },
    {
      "type": "function",
      "name": "flag_for_clinician",
      "description": "Escalate to a human clinician the same day. Call this immediately for any red flag: chest pain, fainting, confusion, uncontrolled bleeding, severe allergic reaction, or any mention of self-harm. Call it before you finish your sentence to the patient.",
      "parameters": {
        "type": "object",
        "properties": {
          "reason": { "type": "string", "description": "What the patient said, briefly." },
          "urgency": { "type": "string", "enum": ["same_day", "immediate"], "description": "immediate = call emergency services." }
        },
        "required": ["reason", "urgency"]
      }
    }
  ]
}
